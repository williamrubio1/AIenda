# ─────────────────────────────────────────────────────────────────────────────
# VARIABLES DE ENTORNO — AIenda Backend
# Copiar este archivo como ".env" y completar los valores reales.
# NUNCA subir el archivo ".env" a Git ni a la raíz pública del servidor.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Servidor ─────────────────────────────────────────────────────────────────
# PORT lo inyecta Hostinger automáticamente. En local puedes fijarlo.
PORT=3000
NODE_ENV=production

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=CAMBIA_ESTO_POR_UNA_CADENA_ALEATORIA_MINIMO_32_CHARS
JWT_EXPIRES_IN=8h

# ─── Base de datos MySQL (datos del panel Hostinger > Bases de Datos) ─────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=usuario_db
DB_PASSWORD=contrasena_db
DB_NAME=nombre_db

# ─── Correo SMTP ──────────────────────────────────────────────────────────────
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_USER=noreply@tudominio.com
MAIL_PASSWORD=contrasena_correo
MAIL_FROM="AIenda <noreply@tudominio.com>"

# ─── Redis — OPCIONAL ─────────────────────────────────────────────────────────
# Dejar en blanco si no se usa Redis. La app funciona sin él.
# REDIS_HOST=
# REDIS_PORT=6379
# REDIS_PASSWORD=
